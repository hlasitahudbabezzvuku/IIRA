// Test: Binary search on sorted array
binarySearch(arr: int[], size: int, target: int): int = {
    var low: int = 0;
    var high: int = size - 1;
    while (low <= high) {
        var mid: int = low + (high - low) / 2;
        if (arr[mid] == target) {
            return mid;
        }
        if (arr[mid] < target) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1;
}

main(): int = {
    var arr: int[] = { 1, 3, 5, 7, 9, 11, 13, 15 };
    var result: int = binarySearch(arr, 8, 7);
    return result;
}
