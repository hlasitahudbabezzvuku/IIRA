// Test: Iterative factorial
factorial(n: int): int = {
    var result: int = 1;
    var i: int = 1;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

main(): int = {
    var n: int = 5;
    var result: int = factorial(n);
    $printf("Factorial of %d is %d\n", n, result);
    return 0;
}
