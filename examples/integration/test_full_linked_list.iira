// Test: Linked list operations with stack-allocated nodes
Node: {
    value: int;
    next: Node*;
}

initNode(n: Node*, v: int, nextNode: Node*): void = {
    n.value = v;
    n.next = nextNode;
    return;
}

main(): int = {
    var node3: Node;
    var node2: Node;
    var node1: Node;

    initNode(&node3, 30, null);
    initNode(&node2, 20, &node3);
    initNode(&node1, 10, &node2);

    $printf("Linked list values: ");
    var current: Node* = &node1;
    while (current != null) {
        $printf("%d ", current.value);
        current = current.next;
    }
    $printf("\n");

    return 0;
}
