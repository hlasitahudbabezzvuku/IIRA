// Test: Find prime numbers up to N
isPrime(n: int): int = {
    if (n <= 1) {
        return 0;
    }
    if (n <= 3) {
        return 1;
    }
    var i: int = 2;
    while (i * i <= n) {
        if (n % i == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

countPrimes(limit: int): int = {
    var count: int = 0;
    var i: int = 2;
    while (i <= limit) {
        if (isPrime(i) == 1) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

main(): int = {
    return countPrimes(20);
}
