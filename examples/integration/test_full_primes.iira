// Test: Find prime numbers up to N
isPrime(n: int): int = {
    if (n <= 1) {
        return 0;
    }
    if (n <= 3) {
        return 1;
    }
    var i: int = 2;
    while (i * i <= n) {
        if (n % i == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

printPrimes(limit: int): int = {
    var count: int = 0;
    var i: int = 2;
    $printf("Primes up to %d: ", limit);
    while (i <= limit) {
        if (isPrime(i) == 1) {
            $printf("%d ", i);
            count = count + 1;
        }
        i = i + 1;
    }
    $printf("\n");
    return count;
}

main(): int = {
    var limit: int = 20;
    var count: int = printPrimes(limit);
    $printf("Total primes found: %d\n", count);
    return 0;
}
