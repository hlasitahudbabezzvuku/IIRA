// Test: String length calculation
stringLen(s: char[]): int = {
    var i: int = 0;
    while (s[i] != 0) {
        i = i + 1;
    }
    return i;
}

main(): int = {
    var str: char[] = "Hello";
    var len: int = stringLen(str);
    $printf("String: \"%s\"\n", str);
    $printf("Length: %d\n", len);
    return 0;
}
