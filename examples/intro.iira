/* 
 * This file contains the foundational examples for IIRA. 
 * The compiler must interpret these structures as flat memory blobs (C-compatible structs).
 *
 * A 'Blueprint' is an alias for a C struct. A 'method' is syntactic sugar for a function that
 * takes 'self*' pointer, or 'self' value as the first argument. There is NO runtime metadata,
 * NO virtual tables, and NO hidden allocations.
 * 
 * Rules for the Compiler:
 * 1. 'Blueprint' is a static layout. No metadata allowed.
 * 2. 'self*' = reference (Pointer to current struct).
 * 3. 'self' = value (Copy of struct).
 * 4. Methods without 'self' or 'self*' = static functions (namespaced).
 *
 * When passing composed blueprint pointer to a function expecting one of the parent blueprints,
 * the compiler injects 'ptr + sizeof(<all prceding blueprints>)'.
 */

// 1. Primitives and types
// Types are memory layouts. 'Test1' is just an alias for Float (like 'typedef' in C).
Test1: Float; 

// Test2 is a single-member Blueprint, effectively a struct { Float value; }
Test2: { value: Float; };

// Initialization: Single-member Blueprints allow implicit conversion
var t: Test2 = 0.5f; 

// 2. Blueprints
// Blueprints they are compile-time memory layouts, like structs in C, or classes in C++.
Point: {
    positionX: Float = 0; // Default value (compiler must zero-init if omitted)
    positionY: Float;     // Required field

    // Member Method (Reference): Modifies the point in-place - pass pointer to Point (reference).
    move(self*, dx: Float, dy: Float) {
        self.positionX = self.positionX + dx;
        self.positionY = self.positionY + dy;
    }

    // Member Method (Value): Operates on a copy - pass full struct by value.
    distanceTo(self, to: Point): Float = {
        var dx = self.positionX - to.positionX;
        var dy = self.positionY - to.positionY;
        return $sqrt(dx * dx + dy * dy); // $ prefix denotes C-library interop
    }
};

// 3. Contracts
// Contracts enforce a structural requirement.
// If 'anotherMethod' is called on a type that doesn't define it, the compiler MUST error.
AnotherPoint: {
    anotherMethod1(self*): Int; // Contract: Implementation required by user
    anotherMethod2(self*);      // Implicit 'void' return type
}

// 4. Blending
// This flattens Blueprints into one memory blob. If you blend A and B, the compiler calculates
// the offsets for A and B. When you pass a pointer to the Blended type to a function expecting
// A, the compiler performs 'Pointer Offset Mapping' by adding the offset of A to the pointer.
// Syntax: 'Name: Parent1 { aliases }, Parent2 { aliases }, { ... }'

Car: {
    speed: Float = 5;
    drive(self*, s: Float): Bool = { self.speed = s; return true; }
}

Plane: {
    speed: Float = 20; // Collision risk with Car!
    fly(self*, s: Float): Bool = { return true; }
}

// SuperCar blends two Blueprints.
// Collision resolved via explicit aliasing.
SuperCar: Car { speed as carSpeed }, Plane { speed as planeSpeed }, Blueprint {
    mode: Bool = false;

    // Multiple return values are allowed.
    // The memory layout looks like this: [Car.speed][Plane.speed][SuperCar.mode]
    // To stay C-compatible we use standard C-struct padding.
    switchMode(self*): { success: Bool; mode: Bool; maxSpeed: Float } = {
        self.mode = mode;
        // Pointer adjustment logic: 
        // Accessing 'self.carSpeed' automatically targets the Car portion of the memory.
        return { true, mode, mode ? self.carSpeed : self.planeSpeed };
    }
}

// 5. main - The entry point
main(argc: Int, argv: Char**): UInt = {
    // Basic construction
    var p1: Point = { positionY = 2 }; // positionX defaults to 0
    p1.positionX = 1;

    // Method chaining
    var dist = p1.distanceTo({ 7, 8 });
    
    // Static calling
    var p2 = Point.distanceTo(p1, { 7, 8 });

    // Blueprint can be created implicitly.
    var person1: {
        firstName: Char*;
        lastName: Char*;

        SayHello(self*) = {
            $printf("Hello\n");
        };
    } = { "Todd", "Howard" };

    // 6. Derivation
    // Derivation creates a new blueprint by cloning the blueprint of another variable.
    // This is done at compile-time. The new blueprint shares the shape of the original
    // variable, but does not share its values.
    var person2: person1 = { "John", "carmack" };

    // To copy the variable blueprint and the values, we have to use assignment.
    var person3: person1 = person1;

    // person4 'blends' person1 + { speak }.
    var person4: person1, {
        age: Int;

        speak(self*) = {
            $printf("%s %s\n", self.firstName, self.lastName);
        }
    } = { "Gabe", "Newell" };

    person4.speak();

    return 0;
};
