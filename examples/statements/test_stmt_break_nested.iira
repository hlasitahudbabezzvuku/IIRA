// Test: Break in nested loop (inner only)
main(): int = {
    var i: int = 0;
    var j: int = 0;

    while (i < 10) {
        i = i + 1;
        j = 0;
        while (j < 10) {
            j = j + 1;
            if (j == 5) {
                break;
            }
        }
        if (i == 3) {
            break;
        }
    }

    return i;
}
